# Этот файл — ШАБЛОН. Реальный файл живёт на app-server по пути
# /etc/duma/duma.env, владелец — пользователь duma, права 600,
# и НИКОГДА не попадает в Git (в отличие от этого шаблона).

APP_NAME="Городская Дума API"
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production

# Реальный адрес db-server в host-only сети и реальный пароль —
# подставляются вручную на сервере, не хранятся здесь и не коммитятся.
DATABASE_URL=postgresql+psycopg2://duma_app:ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ@192.168.56.11:5432/duma
