# Скопируйте этот файл в .env и при необходимости измените значения.
# Файл .env реальных секретов НЕ должен попадать в Git (см. .gitignore).

APP_NAME="Городская Дума API"
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development

# По умолчанию — локальный SQLite (для ЛР1 достаточно).
DATABASE_URL=sqlite:///./duma.db

# Пример строки подключения к PostgreSQL (будет использоваться в следующих ЛР):
# DATABASE_URL=postgresql+psycopg2://duma_user:duma_password@db:5432/duma

# Переменные для docker-compose (сервис db), используются вместе с DATABASE_URL выше.
POSTGRES_USER=duma_user
POSTGRES_PASSWORD=duma_password
POSTGRES_DB=duma
